# PLUMED 2.5.1 input: well-tempered multiple-walker metadynamics of LBT1-CONH2 + Lu(III) in water.
# Every walker directory (a/, b/, ...) holds a copy of this file; run with  mdrun -multidir a b c d -plumed plumed.dat.
# Atom numbers refer to the topology in topology/ (peptide atoms 1-260, ion 261).
# Add RESTART as the first line when continuing a run from a checkpoint.

MOLINFO STRUCTURE=../LBT1-1TJB-ref.pdb
WHOLEMOLECULES STRIDE=1 ENTITY0=1-260

# CV1: coordination number of the ion by the ten ligating peptide oxygens
#      (D3 OD1/OD2, N5 OD1, D7 OD1/OD2, W9 O, E11 OE1/OE2, E14 OE1/OE2); water oxygens are excluded
ow: GROUP ATOMS=51,52,77,105,106,139,172,173,206,207
ln: GROUP ATOMS=261
cn: COORDINATION GROUPA=ln GROUPB=ow R_0=0.26 D_0=0.03 NN=16 MM=32

# CV2: C-alpha RMSD from the 1TJB-derived reference structure (optimal alignment)
ca_rmsd: RMSD REFERENCE=../LBT1-1TJB-ref.pdb TYPE=OPTIMAL

# Soft harmonic walls: above Ca RMSD = 0.6 nm and below CN = 5 (kJ/mol per unit CV^2)
UPPER_WALLS ARG=ca_rmsd AT=0.6 EXP=2 KAPPA=300 EPS=1 LABEL=uwall
LOWER_WALLS ARG=cn      AT=5   EXP=2 KAPPA=300 EPS=1 LABEL=lwall

# Well-tempered metadynamics with a bias shared by all walkers (WALKERS_MPI)
METAD ...
 ARG=cn,ca_rmsd
 SIGMA=0.3,0.05
 HEIGHT=1.0
 PACE=500
 TEMP=298
 BIASFACTOR=3
 WALKERS_MPI
 WALKERS_DIR=./
 GRID_MIN=2,0
 GRID_MAX=11,1.1
 GRID_BIN=500,500
 LABEL=meta
... METAD

FLUSH STRIDE=500
ENERGY LABEL=energy
PRINT ARG=* STRIDE=500 FILE=COLVARS
